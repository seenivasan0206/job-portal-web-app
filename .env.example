# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.
# All values below are placeholders — there are no insecure defaults in code.

# Flask
FLASK_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
FLASK_DEBUG=0

# MySQL database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your-db-password-here
DB_NAME=dream_jobs0

# Gmail (used to send OTP emails) — use a Google App Password, NOT your main password
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-app-password-here

# Upload limits
MAX_UPLOAD_MB=5
